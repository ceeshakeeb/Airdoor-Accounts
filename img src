function saveDocument() {
  const num = document.getElementById('doc-number').value.trim();
  if(!num) { toast('Error: Document index tracking code key required!', 'error'); return; }
  
  const rows = document.getElementById('items-container').children;
  let items = [];
  for(let i=0; i<rows.length; i++) {
    items.push({
      desc: rows[i].querySelector('.item-desc').value,
      hsn: rows[i].querySelector('.item-hsn').value,
      qty: parseFloat(rows[i].querySelector('.item-qty').value) || 0,
      rate: parseFloat(rows[i].querySelector('.item-rate').value) || 0
    });
  }

  const record = {
    id: num,
    type: document.getElementById('doc-type').value,
    date: document.getElementById('doc-date').value,
    job: document.getElementById('doc-job').value,
    po: document.getElementById('doc-po').value,
    client: {
      name: document.getElementById('client-name').value,
      gst: document.getElementById('client-gst').value,
      addr: document.getElementById('client-address').value,
      city: document.getElementById('client-city').value,
      contact: document.getElementById('client-contact').value,
      worksite: document.getElementById('doc-worksite').value
    },
    items: items,
    discount: parseFloat(document.getElementById('discount-val').value) || 0,
    taxRate: parseFloat(document.getElementById('tax-rate-select').value) || 18,
    timestamp: Date.now()
  };

  // Prevent double tracking collisions
  const existingIdx = db.records.findIndex(r => r.id === num);
  if(existingIdx >= 0) {
    if(confirm('Record index identifier already tracked! Confirm dataset overwrite integration sequence?')) {
      db.records[existingIdx] = record;
      toast('Existing track array row state overwritten modified successfully.', 'success');
    } else { return; }
  } else {
    db.records.unshift(record);
    toast('New dynamic structural document entry committed to history array ledger.', 'success');
  }

  localStorage.setItem('airdoor_db', JSON.stringify(db));
  updateDashboard();
  syncCloudBackup();
}

function updateDashboard() {
  let invCount = 0, qCount = 0, grossSales = 0;
  
  db.records.forEach(r => {
    if(r.type === 'TAX INVOICE') invCount++;
    if(r.type === 'QUOTATION') qCount++;
    
    // Sub-calculation algorithm blocks to recalculate sums for overview dashboards
    let sub = r.items.reduce((acc, it) => acc + (it.qty * it.rate), 0);
    let taxable = Math.max(0, sub - r.discount);
    let total = taxable + (taxable * (r.taxRate / 100));
    grossSales += total;
  });

  document.getElementById('dash-inv-count').textContent = invCount;
  document.getElementById('dash-quote-count').textContent = qCount;
  document.getElementById('dash-total-sales').textContent = '₹' + grossSales.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2});

  const tbody = document.getElementById('dash-recent-tbody');
  tbody.innerHTML = '';
  
  if(db.records.length === 0) {
    document.getElementById('dashboard-recent-placeholder').style.display = 'block';
    document.getElementById('dash-recent-table').style.display = 'none';
  } else {
    document.getElementById('dashboard-recent-placeholder').style.display = 'none';
    document.getElementById('dash-recent-table').style.display = 'table';
    
    db.records.slice(0, 5).forEach(r => {
      let sub = r.items.reduce((acc, it) => acc + (it.qty * it.rate), 0);
      let t = Math.max(0, sub - r.discount) * (1 + r.taxRate/100);
      
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><strong>${r.id}</strong></td>
        <td>${r.client.name || '-'}</td>
        <td><span class="badge ${r.type==='QUOTATION'?'badge-quote':'badge-invoice'}">${r.type}</span></td>
        <td>${r.date || '-'}</td>
        <td style="font-family:'DM Mono'; font-weight:600;">₹${t.toFixed(2)}</td>
      `;
      tbody.appendChild(tr);
    });
  }
}

function updateHistoryTable() {
  const tbody = document.getElementById('history-tbody');
  tbody.innerHTML = '';
  
  if(db.records.length === 0) {
    document.getElementById('history-placeholder').style.display = 'block';
    document.getElementById('history-table').style.display = 'none';
  } else {
    document.getElementById('history-placeholder').style.display = 'none';
    document.getElementById('history-table').style.display = 'table';
    
    db.records.forEach(r => {
      let sub = r.items.reduce((acc, it) => acc + (it.qty * it.rate), 0);
      let t = Math.max(0, sub - r.discount) * (1 + r.taxRate/100);
      
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><strong>${r.id}</strong></td>
        <td>${r.client.name || '-'}</td>
        <td><span class="badge ${r.type==='QUOTATION'?'badge-quote':'badge-invoice'}">${r.type}</span></td>
        <td>${r.date || '-'}</td>
        <td style="font-family:'DM Mono'; font-weight:600;">₹${t.toFixed(2)}</td>
        <td>
          <button class="btn btn-secondary btn-sm" onclick="loadRecordToWorkspace('${r.id}')">Load Into Workspace</button>
          <button class="btn btn-danger btn-sm" onclick="deleteRecord('${r.id}')">Delete Track</button>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }
}

function loadRecordToWorkspace(id) {
  const r = db.records.find(rec => rec.id === id);
  if(!r) return;
  
  switchSection('create');
  
  document.getElementById('doc-type').value = r.type;
  document.getElementById('doc-number').value = r.id;
  document.getElementById('doc-date').value = r.date;
  document.getElementById('doc-job').value = r.job || '';
  document.getElementById('doc-po').value = r.po || '';
  document.getElementById('tax-rate-select').value = r.taxRate || 18;
  
  document.getElementById('client-name').value = r.client.name || '';
  document.getElementById('client-gst').value = r.client.gst || '';
  document.getElementById('client-address').value = r.client.addr || '';
  document.getElementById('client-city').value = r.client.city || '';
  document.getElementById('client-contact').value = r.client.contact || '';
  document.getElementById('doc-worksite').value = r.client.worksite || '';
  document.getElementById('discount-val').value = r.discount || 0;
  
  const container = document.getElementById('items-container');
  container.innerHTML = '';
  
  r.items.forEach((it, i) => {
    const row = document.createElement('div');
    row.className = 'item-row';
    row.id = `item-row-${Date.now()}-${Math.random().toString(36).substr(2,4)}`;
    row.innerHTML = `
      <div class="item-row-idx">${i+1}</div>
      <div><input type="text" class="form-control item-desc" value="${it.desc||''}" oninput="syncLivePreview()"></div>
      <div><input type="text" class="form-control item-hsn" value="${it.hsn||''}" oninput="syncLivePreview()"></div>
      <div><input type="number" class="form-control item-qty" value="${it.qty||1}" min="0" step="any" oninput="calcTotals()"></div>
      <div><input type="number" class="form-control item-rate" value="${it.rate||0}" min="0" step="any" oninput="calcTotals()"></div>
      <div><input type="text" class="form-control item-amt" value="₹0.00" readonly style="font-family:'DM Mono'; background:var(--gray100); font-weight:600;"></div>
      <div><button class="btn btn-danger btn-sm" style="padding:6px;" onclick="removeItem('${row.id}')">✕</button></div>
    `;
    container.appendChild(row);
  });
  
  calcTotals();
  toast(`Record context ${id} successfully mapped back into construction matrix fields!`, 'success');
}

function deleteRecord(id) {
  if(!confirm(`Confirm destruction authorization path for reference identifier code: ${id}?`)) return;
  db.records = db.records.filter(r => r.id !== id);
  localStorage.setItem('airdoor_db', JSON.stringify(db));
  updateHistoryTable();
  updateDashboard();
  syncCloudBackup();
  toast('Item element sequence destroyed successfully.', 'error');
}

function triggerPrint() {
  window.print();
}

function factoryResetSystem() {
  if(!confirm('CRITICAL WARN OVERLAY: Complete data matrix loss loop event! Confirm clearing configurations?')) return;
  localStorage.clear();
  location.reload();
}

// ═══════════════════════════════════════════════════════
// ALGORITHMIC TEXT DISPATCH TRANSLATION UTILITIES
// ═══════════════════════════════════════════════════════
function numberToWords(num) {
  if (num === 0) return 'Zero';
  const a = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
  const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
  
  function g(n) {
    if (n < 20) return a[n];
    let d = n % 10;
    return b[Math.floor(n / 10)] + (d ? ' ' + a[d] : '');
  }
  function c(n) {
    if (n < 100) return g(n);
    return a[Math.floor(n / 100)] + ' Hundred' + (n % 100 ? ' and ' + g(n % 100) : '');
  }
  
  let str = '';
  let k = Math.floor(num / 10000000);
  if (k) { str += c(k) + ' Crore '; num %= 10000000; }
  let l = Math.floor(num / 100000);
  if (l) { str += c(l) + ' Lakh '; num %= 100000; }
  let t = Math.floor(num / 1000);
  if (t) { str += c(t) + ' Thousand '; num %= 1000; }
  if (num) { str += c(num); }
  return str.trim();
}

function resetForm() {
  if (!confirm('Clear all form fields?')) return;
  ['doc-number','doc-date','doc-job','doc-po','client-name','client-gst','client-address','client-city','client-contact','doc-worksite','doc-terms'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
  document.getElementById('items-container').innerHTML = '';
  document.getElementById('discount-val').value = '0';
  calcTotals();
  addItem(); // start with one empty row
}

