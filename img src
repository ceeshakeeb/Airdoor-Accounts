<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Airdoor Billing System</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js\"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js\"></script>
<style>
  :root {
    --navy: #0f1b2d;
    --navy2: #162236;
    --blue: #1a6bff;
    --blue-light: #e8f0ff;
    --gold: #c8922a;
    --gold-light: #fdf3e3;
    --white: #ffffff;
    --gray50: #f8fafc;
    --gray100: #f1f5f9;
    --gray200: #e2e8f0;
    --gray300: #cbd5e1;
    --gray600: #475569;
    --gray900: #0f172a;
    --text: #334155;
    --text-dark: #0f172a;
    --sidebar-w: 280px;
    --radius: 12px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'DM Sans', sans-serif; }
  body { background-color: var(--gray50); color: var(--text); font-size: 14px; line-height: 1.5; overflow-x: hidden; }

  /* App Layout Structure */
  .app-container { display: flex; min-height: 100vh; }
  .sidebar { width: var(--sidebar-w); background: var(--navy); color: var(--white); padding: 24px; display: flex; flex-direction: column; gap: 24px; position: fixed; height: 100vh; z-index: 100; box-shadow: 4px 0 20px rgba(0,0,0,0.1); }
  .main-content { margin-left: var(--sidebar-w); flex: 1; padding: 40px; background: var(--gray50); min-width: 0; }

  /* Typography / Branding */
  .brand { display: flex; align-items: center; gap: 12px; font-family: 'Playfair Display', serif; font-weight: 700; font-size: 22px; color: var(--white); padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .brand span { color: var(--gold); }

  /* Nav Links */
  .nav-menu { display: flex; flex-direction: column; gap: 6px; list-style: none; }
  .nav-item a { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: var(--radius); color: #94a3b8; text-decoration: none; font-weight: 500; transition: all 0.2s; cursor: pointer; }
  .nav-item.active a, .nav-item a:hover { background: var(--navy2); color: var(--white); }
  .nav-item.active a { border-left: 4px solid var(--gold); border-radius: 0 var(--radius) var(--radius) 0; padding-left: 12px; }

  /* Dashboard Cards */
  .dashboard-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }
  .db-card { background: var(--white); padding: 20px; border-radius: var(--radius); border: 1px solid var(--gray200); display: flex; flex-direction: column; gap: 8px; position: relative; overflow: hidden; }
  .db-card::after { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--blue); }
  .db-card.gold::after { background: var(--gold); }
  .db-card-title { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--gray600); font-weight: 600; }
  .db-card-val { font-size: 24px; font-weight: 700; color: var(--text-dark); }

  /* Section Containers */
  .app-section { display: none; }
  .app-section.active { display: block; animation: fadeIn 0.3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .section-title { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: var(--text-dark); margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; }

  /* Workspace Layout Split */
  .workspace { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: start; }
  @media (max-width: 1400px) { .workspace { grid-template-columns: 1fr; } }

  /* Form Panels */
  .panel { background: var(--white); border-radius: var(--radius); border: 1px solid var(--gray200); padding: 24px; margin-bottom: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
  .panel-title { font-size: 16px; font-weight: 600; color: var(--navy); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--gray100); display: flex; justify-content: space-between; align-items: center; }
  
  /* Form Inputs */
  .form-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }
  .col-12 { grid-column: span 12; }
  .col-6 { grid-column: span 6; }
  .col-4 { grid-column: span 4; }
  .col-3 { grid-column: span 3; }
  .col-2 { grid-column: span 2; }
  .col-8 { grid-column: span 8; }

  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 12px; font-weight: 600; color: var(--gray600); text-transform: uppercase; letter-spacing: 0.5px; }
  .form-control { width: 100%; padding: 10px 14px; border: 1px solid var(--gray300); border-radius: 8px; font-size: 14px; color: var(--text-dark); background: var(--white); transition: border-color 0.2s; }
  .form-control:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px var(--blue-light); }
  textarea.form-control { resize: vertical; min-height: 70px; }

  /* Button styling */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; white-space: nowrap; text-decoration: none; }
  .btn-primary { background: var(--blue); color: var(--white); }
  .btn-primary:hover { background: #0056e0; }
  .btn-secondary { background: var(--gray100); color: var(--text-dark); border: 1px solid var(--gray300); }
  .btn-secondary:hover { background: var(--gray200); }
  .btn-gold { background: var(--gold); color: var(--white); }
  .btn-gold:hover { background: #b07f21; }
  .btn-danger { background: #ef4444; color: var(--white); }
  .btn-danger:hover { background: #dc2626; }
  .btn-sm { padding: 6px 12px; font-size: 12px; border-radius: 6px; }

  /* Dynamic Item Table controls */
  .items-table-header { display: grid; grid-template-columns: 30px 2fr 1fr 1fr 1fr 1fr 40px; gap: 10px; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--gray600); margin-bottom: 8px; padding: 0 4px; }
  .item-row { display: grid; grid-template-columns: 30px 2fr 1fr 1fr 1fr 1fr 40px; gap: 10px; align-items: center; margin-bottom: 8px; background: var(--gray50); padding: 6px; border-radius: 8px; border: 1px solid var(--gray200); }
  .item-row-idx { font-size: 12px; font-weight: bold; text-align: center; color: var(--gray600); }

  /* Live Preview A4 Target */
  .preview-panel { background: #cbd5e1; padding: 30px; border-radius: var(--radius); display: flex; justify-content: center; overflow-x: auto; position: sticky; top: 40px; }
  .a4-page { 
    width: 210mm; 
    height: 297mm; 
    background: var(--white); 
    box-shadow: 0 10px 25px rgba(0,0,0,0.15); 
    padding: 15mm 15mm 10mm 15mm; /* Margins configured safely */
    display: flex; 
    flex-direction: column; 
    position: relative; 
    color: #1e293b; 
    font-size: 12px; 
    line-height: 1.4;
    box-sizing: border-box;
  }

  /* Document Preview Specific Styling */
  .pv-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid var(--navy); padding-bottom: 12px; margin-bottom: 15px; }
  .pv-logo-area { display: flex; flex-direction: column; align-items: flex-start; }
  .pv-logo { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 26px; color: var(--navy); line-height: 1.1; }
  .pv-logo span { color: var(--gold); }
  .pv-tagline { font-size: 9.5px; font-weight: 700; text-transform: uppercase; color: var(--gray600); letter-spacing: 1.2px; margin-top: 3px; }
  .pv-company-details { text-align: right; font-size: 11px; color: var(--gray600); }
  
  .pv-meta-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px; margin-bottom: 15px; }
  .pv-meta-card { background: var(--gray50); border: 1px solid var(--gray200); padding: 10px; border-radius: 6px; }
  .pv-meta-title { font-size: 11px; text-transform: uppercase; font-weight: 600; color: var(--navy); margin-bottom: 6px; border-bottom: 1px solid var(--gray200); padding-bottom: 2px; }
  
  .pv-doc-type-banner { text-align: center; background: var(--navy); color: var(--white); font-weight: 600; text-transform: uppercase; letter-spacing: 2px; padding: 4px; font-size: 13px; margin-bottom: 15px; border-radius: 4px; }
  
  /* Preview Table */
  .pv-table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
  .pv-table th { background: var(--gray100); color: var(--navy); font-weight: 600; text-transform: uppercase; font-size: 10px; padding: 6px 8px; border: 1px solid var(--gray200); text-align: left; }
  .pv-table td { padding: 6px 8px; border: 1px solid var(--gray200); font-size: 11px; vertical-align: top; }
  .pv-table th.num, .pv-table td.num { text-align: right; font-family: 'DM Mono', monospace; }
  
  .pv-calc-area { display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px; margin-bottom: 15px; page-break-inside: avoid; }
  .pv-words-block { font-style: italic; color: var(--gray600); font-size: 11px; }
  .pv-totals-table { width: 100%; border-collapse: collapse; }
  .pv-totals-table td { padding: 4px 8px; border: 1px solid var(--gray200); font-size: 11px; }
  .pv-totals-table tr.grand { background: var(--navy); color: var(--white); font-weight: bold; }
  .pv-totals-table tr.grand td { border-color: var(--navy); }
  
  /* Reduced & Fixed Bottom Footer Area (Modified) */
  .pv-footer-wrapper {
    position: absolute;
    bottom: 10mm; /* Sticks exactly above bottom margin edge */
    left: 15mm;
    right: 15mm;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 6px;
    page-break-inside: avoid;
  }
  
  .pv-footer-divider {
    height: 1px;
    background: var(--gray300);
    width: 100%;
    margin-bottom: 2px;
  }

  .pv-footer-grid { 
    display: grid; 
    grid-template-columns: 1.4fr 1fr; 
    gap: 15px; 
    align-items: end;
  }
  
  .pv-bank-box { 
    border: 1px dashed var(--gray300); 
    padding: 6px 8px; 
    border-radius: 4px; 
    background: #fafafa;
    font-size: 10px;
    line-height: 1.3;
  }
  
  .pv-bank-title { 
    font-weight: bold; 
    color: var(--navy); 
    margin-bottom: 2px; 
    text-transform: uppercase;
    font-size: 10px;
  }
  
  .pv-sign-box { 
    text-align: right; 
    font-size: 10px;
    line-height: 1.3;
  }
  
  .pv-sign-space { 
    height: 35px; /* Scaled down footprint */
  }
  
  .pv-thankyou-bar { 
    text-align: center; 
    font-weight: 600; 
    text-transform: uppercase; 
    letter-spacing: 1px; 
    color: var(--navy); 
    font-size: 10px;
    margin-top: 2px;
    padding-top: 4px;
    border-top: 1px solid var(--gray200);
  }

  /* Terms View Box */
  .pv-terms-box {
    margin-top: 5px;
    font-size: 10.5px;
    color: var(--text);
  }
  .pv-terms-box strong {
    color: var(--navy);
    display: block;
    margin-bottom: 3px;
  }
  .pv-terms-box ul {
    margin-left: 15px;
    padding-left: 0;
  }
  .pv-terms-box li {
    margin-bottom: 2px;
  }

  /* Data Table List views */
  .data-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  .data-table th { background: var(--navy); color: var(--white); padding: 12px; text-align: left; font-size: 12px; text-transform: uppercase; }
  .data-table td { padding: 12px; border-bottom: 1px solid var(--gray200); font-size: 14px; color: var(--text-dark); }
  .data-table tr:hover { background: var(--gray50); }
  
  /* Status pill badges */
  .badge { display: inline-flex; padding: 4px 8px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
  .badge-invoice { background: var(--blue-light); color: var(--blue); }
  .badge-quote { background: var(--gold-light); color: var(--gold); }

  /* Toast Notification */
  #toast { position: fixed; bottom: 20px; right: 20px; background: var(--navy); color: var(--white); padding: 12px 24px; border-radius: 8px; font-weight: 500; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); transform: translateY(100px); opacity: 0; transition: all 0.3s ease; z-index: 9999; }
  #toast.show { transform: translateY(0); opacity: 1; }
  #toast.success { border-left: 4px solid #10b981; }
  #toast.error { border-left: 4px solid #ef4444; }

  /* Print Specific Optimization Styles Override */
  @media print {
    body { background: transparent; color: #000; }
    .sidebar, .main-content > :not(.app-section.active), .panel, .section-title, .preview-panel { display: none !important; }
    .app-section.active { display: block !important; }
    .main-content { margin-left: 0 !important; padding: 0 !important; background: transparent !important; }
    .preview-panel { padding: 0 !important; background: transparent !important; display: block !important; }
    .a4-page { box-shadow: none !important; margin: 0 !important; padding: 15mm 15mm 10mm 15mm !important; position: relative !important; page-break-after: avoid; page-break-inside: avoid; }
  }
</style>
</head>
<body>

<div class="app-container">
  
  <aside class="sidebar">
    <div class="brand">Airdoor<span>.</span></div>
    <ul class="nav-menu">
      <li class="nav-item active" id="nav-dash" onclick="switchSection('dashboard')"><a>Dashboard</a></li>
      <li class="nav-item" id="nav-create" onclick="switchSection('create')"><a>Create Document</a></li>
      <li class="nav-item" id="nav-history" onclick="switchSection('history')"><a>History Logs</a></li>
      <li class="nav-item" id="nav-settings" onclick="switchSection('settings')"><a>Settings Profile</a></li>
    </ul>
    
    <div style="margin-top: auto; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.1); display:flex; flex-direction:column; gap:10px;">
      <div id="gdrive-status" style="font-size:11px; color:#94a3b8; display:flex; align-items:center; gap:6px;">
        <span style="width:8px; height:8px; background:#ef4444; border-radius:50%; display:inline-block;" id="gdrive-indicator"></span>
        Cloud Disconnected
      </div>
      <button class="btn btn-secondary btn-sm" id="btn-connect-gdrive" onclick="handleGDriveAuth()">Connect Google Drive</button>
    </div>
  </aside>

  <main class="main-content">
    
    <section id="sec-dashboard" class="app-section active">
      <h1 class="section-title">Dashboard Overview</h1>
      <div class="dashboard-grid">
        <div class="db-card">
          <div class="db-card-title">Total Invoices Raised</div>
          <div class="db-card-val" id="dash-inv-count">0</div>
        </div>
        <div class="db-card gold">
          <div class="db-card-title">Total Quotations Generated</div>
          <div class="db-card-val" id="dash-quote-count">0</div>
        </div>
        <div class="db-card">
          <div class="db-card-title">Gross Combined Valuation</div>
          <div class="db-card-val" id="dash-total-sales">₹0.00</div>
        </div>
      </div>
      
      <div class="panel">
        <div class="panel-title">Recent System Activities</div>
        <div id="dashboard-recent-placeholder" style="color:var(--gray600); font-style:italic; padding:10px 0;">No active standard records discovered on this machine instance yet. Go ahead and draft standard workflows!</div>
        <table class="data-table" id="dash-recent-table" style="display:none;">
          <thead>
            <tr>
              <th>Doc ID</th>
              <th>Client Handle</th>
              <th>Category</th>
              <th>Dated</th>
              <th>Gross Value</th>
            </tr>
          </thead>
          <tbody id="dash-recent-tbody"></tbody>
        </table>
      </div>
    </section>

    <section id="sec-create" class="app-section">
      <div class="section-title">
        <span>Document Builder Engine</span>
        <div style="display: flex; gap: 10px;">
          <button class="btn btn-secondary" onclick="resetForm()">Clear Form</button>
          <button class="btn btn-gold" onclick="triggerPrint()">Print / Print to PDF</button>
          <button class="btn btn-primary" onclick="saveDocument()">Commit Record &amp; Backup</button>
        </div>
      </div>

      <div class="workspace">
        
        <div class="controls-column">
          
          <div class="panel">
            <div class="panel-title">Metadata Settings Configuration</div>
            <div class="form-grid">
              <div class="form-group col-4">
                <label for="doc-type">Target Framework Block</label>
                <select id="doc-type" class="form-control" onchange="syncLivePreview()">
                  <option value="TAX INVOICE">Tax Invoice</option>
                  <option value="QUOTATION">Commercial Quotation</option>
                </select>
              </div>
              <div class="form-group col-4">
                <label for="doc-number">Reference Number</label>
                <input type="text" id="doc-number" class="form-control" placeholder="e.g., AD/26-27/042" oninput="syncLivePreview()">
              </div>
              <div class="form-group col-4">
                <label for="doc-date">Calendar Date</label>
                <input type="date" id="doc-date" class="form-control" onchange="syncLivePreview()">
              </div>
              <div class="form-group col-4">
                <label for="doc-job">Project Job Identifier</label>
                <input type="text" id="doc-job" class="form-control" placeholder="Job Ref Code" oninput="syncLivePreview()">
              </div>
              <div class="form-group col-4">
                <label for="doc-po">PO / WO Tracking Code</label>
                <input type="text" id="doc-po" class="form-control" placeholder="Client Order Ref" oninput="syncLivePreview()">
              </div>
              <div class="form-group col-4">
                <label for="tax-rate-select">Applicable GST Scheme</label>
                <select id="tax-rate-select" class="form-control" onchange="calcTotals()">
                  <option value="18">Standard IGST/CGST-SGST (18%)</option>
                  <option value="28">Premium Luxury Tier (28%)</option>
                  <option value="5">Reduced Base Bracket (5%)</option>
                  <option value="12">Alternative Middle Class (12%)</option>
                  <option value="0">Zero Tax / Exempted (0%)</option>
                </select>
              </div>
            </div>
          </div>

          <div class="panel">
            <div class="panel-title">Target Client Registry</div>
            <div class="form-grid">
              <div class="form-group col-6">
                <label for="client-name">Corporate Entity / Customer</label>
                <input type="text" id="client-name" class="form-control" placeholder="Full Registered Corporate Designation Name" oninput="syncLivePreview()">
              </div>
              <div class="form-group col-6">
                <label for="client-gst">Client GSTIN Registration</label>
                <input type="text" id="client-gst" class="form-control" placeholder="22AAAAA0000A1Z5" oninput="syncLivePreview()">
              </div>
              <div class="form-group col-12">
                <label for="client-address">Billing Registry Address Office</label>
                <textarea id="client-address" class="form-control" placeholder="Registered premises architectural site tracking string address location details" oninput="syncLivePreview()"></textarea>
              </div>
              <div class="form-group col-6">
                <label for="client-city">City/State/Zip Jurisdiction</label>
                <input type="text" id="client-city" class="form-control" placeholder="Mumbai, MH, 400001" oninput="syncLivePreview()">
              </div>
              <div class="form-group col-6">
                <label for="client-contact">Point Of Contact Phone/Email</label>
                <input type="text" id="client-contact" class="form-control" placeholder="+91-XXXXXXXXXX / primary@clientmail.org" oninput="syncLivePreview()">
              </div>
              <div class="form-group col-12">
                <label for="doc-worksite">Worksite Deployment Destination Location</label>
                <input type="text" id="doc-worksite" class="form-control" placeholder="If matching billing field description string completely leave blank space asset details" oninput="syncLivePreview()">
              </div>
            </div>
          </div>

          <div class="panel">
            <div class="panel-title">
              <span>Transactional Itemization Rows Matrix</span>
              <button class="btn btn-primary btn-sm" onclick="addItem()">Insert Matrix Row Link Block</button>
            </div>
            
            <div class="items-table-header">
              <div>#</div>
              <div>Description</div>
              <div>HSN/SAC</div>
              <div>Qty</div>
              <div>Rate</div>
              <div>Amount</div>
              <div></div>
            </div>

            <div id="items-container">
              </div>
            
            <div class="form-grid" style="margin-top: 16px; border-top: 1px solid var(--gray200); padding-top:16px;">
               <div class="form-group col-6">
                 <label for="discount-val">Strategic Discount Deductible (₹)</label>
                 <input type="number" id="discount-val" class="form-control" value="0" min="0" oninput="calcTotals()">
               </div>
               <div class="form-group col-6">
                 <label>Dynamic Net Aggregate Balance</label>
                 <div id="calc-readout" style="font-family:'DM Mono', monospace; font-size:16px; font-weight:bold; color:var(--blue); padding:10px 0;">₹0.00</div>
               </div>
            </div>
          </div>

          <div class="panel">
            <div class="panel-title">Legal Terms, Conditions &amp; Directives</div>
            <div class="form-grid">
              <div class="form-group col-12">
                <label for="doc-terms">Custom Overlay Notes (Optional)</label>
                <textarea id="doc-terms" class="form-control" placeholder="Append any additional notes or details here..." oninput="syncLivePreview()"></textarea>
              </div>
            </div>
          </div>

        </div>

        <div class="preview-panel">
          <div class="a4-page" id="print-canvas">
            
            <div class="pv-header">
              <div class="pv-logo-area">
                <div class="pv-logo">Airdoor<span>.</span></div>
                <div class="pv-tagline">MEP Solutions</div>
              </div>
              <div class="pv-company-details">
                <strong style="color:var(--navy); font-size:12px;" id="pv-owner-name">AIRDOOR INTERNAL CORP</strong><br>
                <span id="pv-owner-addr">Administrative HQ Corporate Complex Suite, Ind. Area Zone 7</span><br>
                <span id="pv-owner-city">New Delhi, DL, 110001</span><br>
                <span>GSTIN: </span><strong id="pv-owner-gst" style="color:var(--text-dark)">07AAAAA0000A1Z0</strong><br>
                <span>Email/Contact: </span><span id="pv-owner-contact">operations@airdoor.example.com</span>
              </div>
            </div>
            
            <div class="pv-doc-type-banner" id="pv-doc-title">TAX INVOICE</div>
            
            <div class="pv-meta-grid">
              <div class="pv-meta-card">
