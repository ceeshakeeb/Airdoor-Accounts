// ═══════════════════════════════════════════════════════
function calcTotals() {
  const rows = document.getElementById('items-container').children;
  let subtotal = 0;
  
  for(let i=0; i<rows.length; i++) {
    const qty = parseFloat(rows[i].querySelector('.item-qty').value) || 0;
    const rate = parseFloat(rows[i].querySelector('.item-rate').value) || 0;
    const amt = qty * rate;
    subtotal += amt;
    rows[i].querySelector('.item-amt').value = '₹' + amt.toFixed(2);
  }
  
  const disc = parseFloat(document.getElementById('discount-val').value) || 0;
  const taxableAmt = Math.max(0, subtotal - disc);
  
  const taxRate = parseFloat(document.getElementById('tax-rate-select').value) || 18;
  const totalTax = taxableAmt * (taxRate / 100);
  const grandTotal = taxableAmt + totalTax;
  
  document.getElementById('calc-readout').textContent = '₹' + grandTotal.toFixed(2);
  
  // Directly write dynamic figures down directly into preview boxes
  document.getElementById('pv-t-sub').textContent = '₹' + subtotal.toFixed(2);
  if (disc > 0) {
    document.getElementById('pv-t-disc-tr').style.display = 'table-row';
    document.getElementById('pv-t-disc').textContent = '-₹' + disc.toFixed(2);
  } else {
    document.getElementById('pv-t-disc-tr').style.display = 'none';
  }
  
  // Splitting up calculation models depending on destination boundaries logic handles
  const isInvoice = document.getElementById('doc-type').value === "TAX INVOICE";
  
  // Standard Domestic GST distribution split computation matrix paths
  const halfTax = totalTax / 2;
  document.getElementById('pv-t-cgst').textContent = '₹' + halfTax.toFixed(2);
  document.getElementById('pv-t-sgst').textContent = '₹' + halfTax.toFixed(2);
  document.getElementById('pv-t-igst').textContent = '₹' + totalTax.toFixed(2);
  
  // Realtime display toggles depending on requirements definitions
  if(taxRate === 0) {
    document.getElementById('pv-t-cgst-tr').style.display = 'none';
    document.getElementById('pv-t-sgst-tr').style.display = 'none';
    document.getElementById('pv-t-igst-tr').style.display = 'none';
  } else {
    // Assuming central intra state as general tracking fallback template engine parameters inside demo space
    document.getElementById('pv-t-cgst-tr').style.display = 'table-row';
    document.getElementById('pv-t-sgst-tr').style.display = 'table-row';
    document.getElementById('pv-t-igst-tr').style.display = 'none';
  }
  
  document.getElementById('pv-t-grand').textContent = '₹' + grandTotal.toFixed(2);
  document.getElementById('pv-words-out').textContent = numberToWords(Math.round(grandTotal)) + " Rupees Only";
  
  syncLivePreview();
}

