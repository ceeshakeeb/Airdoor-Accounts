  const row = document.createElement('div');
  row.className = 'item-row';
  row.id = `item-row-${Date.now()}-${Math.random().toString(36).substr(2,4)}`;
  row.innerHTML = `
    <div class="item-row-idx">${idx}</div>
    <div><input type="text" class="form-control item-desc" placeholder="Component Spec Entry" oninput="syncLivePreview()"></div>
